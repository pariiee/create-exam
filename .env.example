# Google Sheets Configuration
# Paste your full service account JSON as a single line here
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id",...}

# Your Google Sheet ID
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SETTINGS_SHEET_ID=
# Admin password for accessing /admin page
ADMIN_PASSWORD=your_admin_password_here

# Encryption key for AES-256-CBC (used to encrypt url_ujian & pin_out)
ENCRYPTION_KEY=your_encryption_key_here
